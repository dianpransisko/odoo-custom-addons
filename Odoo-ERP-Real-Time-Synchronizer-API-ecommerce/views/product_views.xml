<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_ecommerce_inherit" model="ir.ui.view">
        <field name="name">product.template.ecommerce.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Ecommerce Mapping">
                    <field name="external_item_id"/>
                    <field name="last_sync_stock"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>