<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="ir_cron_auto_sync_stock" model="ir.cron">
            <field name="name">Ecommerce: Auto Push Stock Update</field>
            <field name="model_id" ref="model_ecommerce_connector"/>
            <field name="state">code</field>
            <field name="code">model.sync_product_stock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field> <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <record id="ir_cron_auto_sync_orders" model="ir.cron">
            <field name="name">Ecommerce: Auto Sync Orders</field>
            <field name="model_id" ref="model_ecommerce_connector"/>
            <field name="state">code</field>
            <field name="code">model.sync_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field> <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

    </data>
</odoo>