<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_shelf" model="ir.ui.view">
        <field name="name">product.template.form.inherit.shelf</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='responsible_id']" position="after">
                <field name="shelf_location"/>
            </xpath>
        </field>
    </record>
</odoo>